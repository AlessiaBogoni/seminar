{
  "name": "intro-meeting",
  "type": "module",
  "private": true,
  "scripts": {
    "build:intro": "slidev build Intro.md --base /seminar/Intro_Meeting/dist-slides/Intro/ --out dist-slides/Intro && node -e \"require('fs').copyFileSync('dist-slides/Intro/index.html', 'dist-slides/Intro/404.html')\"",
    "build:emp": "slidev build Intro_emp.md --base /seminar/Intro_Meeting/dist-slides/Intro_emp/ --out dist-slides/Intro_emp && node -e \"require('fs').copyFileSync('dist-slides/Intro_emp/index.html', 'dist-slides/Intro_emp/404.html')\"",
    "build:reading": "slidev build Intro_reading.md --base /seminar/Intro_Meeting/dist-slides/Intro_reading/ --out dist-slides/Intro_reading && node -e \"require('fs').copyFileSync('dist-slides/Intro_reading/index.html', 'dist-slides/Intro_reading/404.html')\"",
    "build:writing": "slidev build Intro_writing.md --base /seminar/Intro_Meeting/dist-slides/Intro_writing/ --out dist-slides/Intro_writing && node -e \"require('fs').copyFileSync('dist-slides/Intro_writing/index.html', 'dist-slides/Intro_writing/404.html')\"",
    "build:all": "npm run build:intro && npm run build:emp && npm run build:reading && npm run build:writing",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "latest",
    "floating-vue": "^5.4.0",
    "vue": "^3.5.43"
  }
}
